# =============================================================================
# Amigos SACCO — AI-Proctored Examination System
# Copy this file to `.env` in the PROJECT ROOT (same folder as package.json).
# The backend reads it via dotenv; the value of NODE_ENV also decides whether
# Express serves the built React app or just an API.
# =============================================================================

# ---- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---- Database ---------------------------------------------------------------
# Local MongoDB:
MONGO_URL=mongodb://127.0.0.1:27017/amigos_exams
# Or MongoDB Atlas (replace user, password, cluster — URL-encode any special
# characters in the password, e.g. @ becomes %40):
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/amigos_exams?retryWrites=true&w=majority

# ---- Auth -------------------------------------------------------------------
# CHANGE THIS before any real use. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ---- CORS -------------------------------------------------------------------
# Comma-separated. 3000 is the React dev server; 5000 is the API itself.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ---- Certification ----------------------------------------------------------
# Minimum percentage at which a certificate is issued (see
# backend/config/certificateConfig.js).
CERT_PASS_THRESHOLD=50

# ---- Organisation (see backend/config/brandConfig.js) ------------------------
SUPPORT_EMAIL=pmerlf@amigossacco.com
ORG_WEBSITE=https://www.amigossacco.com

# ---- Certificate signatories (see backend/config/certificateConfig.js) -------
# REQUIRED before issuing any live certificate. A credential goes out with a
# public, verifiable serial — it cannot be quietly corrected afterwards.
CEO_NAME=
PMERLF_CHIEF_NAME=Chief of PMERLF
CERT_PLACE_OF_ISSUE=Addis Ababa, Ethiopia

# Optional: transparent PNGs of the scanned signatures, placed under
# frontend/public/signatures/ and referenced by public path. If unset, the
# certificate prints a ruled signature line for wet signing instead.
# CEO_SIGNATURE_IMAGE=/signatures/ceo-signature.png
# PMERLF_SIGNATURE_IMAGE=/signatures/pmerlf-signature.png
